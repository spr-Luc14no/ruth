{
  "name": "RailGuardStartBootstrap",
  "version": "1.0.0",
  "status": "canonical",
  "description": "Canonical field contract for @start railguard local bootstrap. This command loads the RailGuard contract and shallow project scope without implementing, testing, validating Git, or approving work.",
  "display_format": "bracketed_lines",
  "required_fields": [
    { "key": "status", "label": "AI GUARDRAILS STATUS" },
    { "key": "start_mode", "label": "Start mode" },
    { "key": "project_root", "label": "Project root" },
    { "key": "railguard_root", "label": "RailGuard root" },
    { "key": "files_accessible", "label": "Files accessible" },
    { "key": "required_files_loaded", "label": "Required files loaded" },
    { "key": "files_actually_read", "label": "Files actually read" },
    { "key": "files_not_accessible", "label": "Files not accessible" },
    { "key": "missing_required_files", "label": "Missing required files" },
    { "key": "contract_loaded", "label": "RailGuard contract loaded" },
    { "key": "current_scope_source", "label": "Current scope source" },
    { "key": "current_scope_loaded", "label": "Current scope loaded" },
    { "key": "user_profile", "label": "User profile" },
    { "key": "work_mode", "label": "Work mode" },
    { "key": "project_stage", "label": "Project stage" },
    { "key": "git_used", "label": "Git used" },
    { "key": "github_used", "label": "GitHub used" },
    { "key": "sensitive_areas_detected", "label": "Sensitive areas detected" },
    { "key": "risk_level", "label": "Risk level" },
    { "key": "default_allowed_scope", "label": "Default allowed scope" },
    { "key": "default_forbidden_scope", "label": "Default forbidden scope" },
    { "key": "evidence_status", "label": "Evidence status" },
    { "key": "can_continue", "label": "Can continue" },
    { "key": "next_required_input", "label": "Next required input" },
    { "key": "next_safe_action", "label": "Next safe action" }
  ],
  "allowed_start_modes": ["local-bootstrap", "fallback-no-files"],
  "allowed_contract_loaded": ["complete", "partial", "fallback-only"],
  "allowed_can_continue": ["partial", "stop"],
  "allowed_reads": [
    "railguard_contract",
    "critical_rules",
    "agent_or_one_shot",
    "prompt_library",
    "current_scope",
    "run_log",
    "handoff",
    "evidence_pack",
    "shallow_project_map"
  ],
  "forbidden_during_bootstrap": [
    "implementation",
    "file_edits",
    "tests",
    "builds",
    "audits",
    "package_installs",
    "git_validation",
    "ci_validation",
    "deploy_validation",
    "commit",
    "push",
    "pull_request",
    "approval"
  ],
  "rules": [
    "bare_start_must_not_read_files",
    "start_railguard_must_list_files_actually_read",
    "start_railguard_must_not_return_short_acknowledgement",
    "start_railguard_must_ask_mandatory_questions_when_context_is_missing",
    "one_shot_is_fallback_only_when_local_files_are_inaccessible",
    "missing_required_files_blocks_implementation",
    "missing_source_run_blocks_evidence_or_handoff_after_bootstrap",
    "bootstrap_never_approves_code_security_git_ci_deploy_or_payment"
  ]
}
