{
  "name": "GitRealityCheck",
  "version": "1.0.0",
  "status": "canonical",
  "description": "Canonical field contract for Git state, branch scope, commit, PR, worktree, and scope drift checks.",
  "required_fields": [
    { "key": "run_id", "label": "RUN_ID" },
    { "key": "request_run_id", "label": "Request RUN_ID" },
    { "key": "source_run_id", "label": "Source RUN_ID" },
    { "key": "source_run_id_status", "label": "Source RUN_ID status" },
    { "key": "git_available", "label": "Git available" },
    { "key": "git_repo_detected", "label": "Git repo detected" },
    { "key": "current_branch", "label": "Current branch" },
    { "key": "expected_branch", "label": "Expected branch" },
    { "key": "branch_source", "label": "Branch source" },
    { "key": "branch_task_fit", "label": "Branch-task fit" },
    { "key": "worktree_status", "label": "Worktree status" },
    { "key": "changed_files", "label": "Changed files" },
    { "key": "remote_detected", "label": "Remote detected" },
    { "key": "remote_names", "label": "Remote names" },
    { "key": "github_context_available", "label": "GitHub context available" },
    { "key": "current_pr", "label": "Current PR" },
    { "key": "target_branch", "label": "Target branch" },
    { "key": "requested_git_action", "label": "Requested Git action" },
    { "key": "commit_requested", "label": "Commit requested" },
    { "key": "commit_exists", "label": "Commit exists" },
    { "key": "commit_belongs_to_current_branch", "label": "Commit belongs to current branch" },
    { "key": "scope_drift_detected", "label": "Scope drift detected" },
    { "key": "cross_scope_changes", "label": "Cross-scope changes" },
    { "key": "safe_git_action_now", "label": "Safe Git action now" },
    { "key": "what_can_proceed", "label": "What can proceed" },
    { "key": "what_cannot_proceed", "label": "What cannot proceed" },
    { "key": "can_continue", "label": "Can continue" },
    { "key": "reason", "label": "Reason" },
    { "key": "next_command", "label": "Next command" }
  ],
  "compact_fields": [
    "Current branch",
    "Worktree status",
    "Scope drift detected",
    "Commit exists",
    "Current PR",
    "Can continue",
    "Reason",
    "Next command"
  ],
  "allowed_can_continue": ["ok", "partial", "stop"],
  "modes": ["read", "action", "release"]
}
