{
  "name": "RailGuardActiveResponseEnvelope",
  "version": "1.0.0",
  "status": "canonical",
  "description": "Canonical field contract for every response while RailGuard is active, including casual, conceptual, planning, validation, implementation, and handoff prompts.",
  "display_format": "bracketed_lines",
  "display_rule": "Every human-facing active response field must be rendered as [Label]: value. Do not replace these bracketed labels with prose.",
  "required_fields": [
    { "key": "status", "label": "AI GUARDRAILS STATUS" },
    { "key": "interaction_id", "label": "Interaction ID" },
    { "key": "run_id", "label": "RUN_ID" },
    { "key": "run_id_required", "label": "RUN_ID required" },
    { "key": "response_type", "label": "Response type" },
    { "key": "command_mode", "label": "Command mode" },
    { "key": "request_summary", "label": "Request summary" },
    { "key": "user_profile", "label": "User profile" },
    { "key": "work_mode", "label": "Work mode" },
    { "key": "spec_summary", "label": "Spec summary" },
    { "key": "non_goals", "label": "Non-goals" },
    { "key": "expected_behavior", "label": "Expected behavior" },
    { "key": "acceptance_criteria", "label": "Acceptance criteria" },
    { "key": "bad_paths", "label": "Bad paths" },
    { "key": "stop_rule", "label": "Stop rule" },
    { "key": "raw_prompt_saved", "label": "Raw prompt saved" },
    { "key": "raw_response_saved", "label": "Raw response saved" },
    { "key": "markdown_report", "label": "Markdown report" },
    { "key": "memory_loaded", "label": "Memory loaded" },
    { "key": "scope_status", "label": "Scope status" },
    { "key": "scope_drift_detected", "label": "Scope drift detected" },
    { "key": "current_task", "label": "Current task" },
    { "key": "requested_scope", "label": "Requested scope" },
    { "key": "risk_level", "label": "Risk level" },
    { "key": "execution_contract", "label": "Execution contract" },
    { "key": "evidence_required", "label": "Evidence required" },
    { "key": "evidence_provided", "label": "Evidence provided" },
    { "key": "what_can_proceed", "label": "What can proceed" },
    { "key": "what_cannot_proceed", "label": "What cannot proceed" },
    { "key": "can_continue", "label": "Can continue" },
    { "key": "next_safe_action", "label": "Next safe action" }
  ],
  "recommended_fields": [
    { "key": "request_summary", "label": "Request summary" },
    { "key": "current_task", "label": "Current task" },
    { "key": "requested_scope", "label": "Requested scope" },
