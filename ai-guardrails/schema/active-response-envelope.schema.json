    { "key": "spec_summary", "label": "Spec summary" },
    { "key": "non_goals", "label": "Non-goals" },
    { "key": "expected_behavior", "label": "Expected behavior" },
    { "key": "acceptance_criteria", "label": "Acceptance criteria" },
    { "key": "bad_paths", "label": "Bad paths" },
    { "key": "stop_rule", "label": "Stop rule" },
    { "key": "execution_contract", "label": "Execution contract" },
    { "key": "evidence_required", "label": "Evidence required" },
    { "key": "evidence_provided", "label": "Evidence provided" },
    { "key": "what_can_proceed", "label": "What can proceed" },
    { "key": "what_cannot_proceed", "label": "What cannot proceed" }
  ],
  "work_modes": [
    "guided",
    "balanced",
    "pro",
    "code-first-with-evidence"
  ],
  "response_types": [
    "initialization",
    "casual",
    "concept-question",
    "planning",
    "real-task",
    "validation",
    "handoff",
    "git",
    "final-report",
    "blocked"
  ],
  "rules": [
    "must_appear_in_every_active_response",
    "interaction_id_always_required",
    "run_id_only_required_for_real_tasks",
    "raw_prompt_saved_defaults_to_no",
    "raw_response_saved_defaults_to_no",
    "markdown_report_required_for_copyable_guardrail_state",
    "can_continue_must_be_ok_partial_or_stop",
    "scope_drift_must_stop_until_change_scope"
  ]
}
