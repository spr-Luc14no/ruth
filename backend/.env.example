# ============================================
# RUTh Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha
# ============================================

# Banco de dados (TiDB Cloud em produção, MySQL local em dev)
DATABASE_URL="mysql://root:root@localhost:3306/ruthdb"

# JWT — gere com: openssl rand -hex 32
JWT_SECRET="cole-aqui-a-string-gerada-pelo-openssl"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=3001
NODE_ENV="development"

# CORS — em produção colocar a URL da Vercel
CORS_ORIGIN="http://localhost:5173"

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Bloqueio de conta após N tentativas falhas (RN08 / módulo de acesso)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Admin inicial (criado pelo seed)
ADMIN_EMAIL="admin@ruth.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"
