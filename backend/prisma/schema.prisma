// RUTh — Schema do banco de dados
// Espelha o Diagrama de Classes Persistentes (Figura 8 da documentação)
// Provider: MySQL (compatível com TiDB Cloud em produção)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // TiDB Cloud requer SSL — Prisma já trata via URL com ?sslaccept=strict
}

// ============================================
// ENUMS
// ============================================

enum TipoUsuario {
  A // Admin
  P // Professor
  U // Aluno (User)
}

enum StatusUsuario {
  A // Ativo
  B // Bloqueado
}

enum StatusSessao {
  ABERTA
  ENCERRADA
  PAUSADA
}

enum ValidacaoPresenca {
  OK
  FALHA
  PENDENTE
}

enum StatusPresenca {
  CONFIRMADO
  PENDENTE
  INVALIDO
}

enum TipoPergunta {
  MULTIPLA
  VF
  ENQUETE
  TEXTO
}

// ============================================
// USUÁRIO (Admin / Professor / Aluno)
// ============================================

model Usuario {
  id        Int           @id @default(autoincrement())
  nome      String        @db.VarChar(100)
  email     String        @unique @db.VarChar(100)
  login     String        @unique @db.VarChar(50)
  senha     String        @db.VarChar(255) // hash bcrypt
  tipo      TipoUsuario
  status    StatusUsuario @default(A)
  matricula String?       @unique @db.VarChar(50) // só pra Aluno
  criadoEm  DateTime      @default(now())

  // Relacionamentos
  turmasMinistradas Turma[]         @relation("ProfessorTurma")
  matriculas        Matricula[]
  sessoesAbertas    SessaoChamada[] @relation("ProfessorSessao")
  presencas         Presenca[]
  respostas         Resposta[]
  logs              AuditoriaLog[]

  @@index([tipo, status])
}

// ============================================
// TURMA
// ============================================

model Turma {
  id          Int    @id @default(autoincrement())
  nome        String @db.VarChar(100)
  periodo     String @db.VarChar(50)
  disciplina  String @db.VarChar(100)
  professorId Int

  professor  Usuario         @relation("ProfessorTurma", fields: [professorId], references: [id])
  matriculas Matricula[]
  sessoes    SessaoChamada[]

  @@index([professorId])
}

// Tabela de junção N:N Aluno <-> Turma
model Matricula {
  alunoId Int
  turmaId Int

  aluno Usuario @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([alunoId, turmaId])
}

// ============================================
// SESSÃO DE CHAMADA
// ============================================

model SessaoChamada {
  id                Int          @id @default(autoincrement())
  turmaId           Int
  professorId       Int
  dataAbertura      DateTime     @default(now())
  dataEncerramento  DateTime?
  janelaMin         Int          @default(10) // minutos
  status            StatusSessao @default(ABERTA)
  codigo            String       @unique @db.VarChar(10)

  turma     Turma      @relation(fields: [turmaId], references: [id])
  professor Usuario    @relation("ProfessorSessao", fields: [professorId], references: [id])
  presencas Presenca[]
  perguntas Pergunta[]

  @@index([turmaId, status])
  @@index([codigo])
}

// ============================================
// PRESENÇA
// ============================================

model Presenca {
  id         Int               @id @default(autoincrement())
  sessaoId   Int
  alunoId    Int
  marcadoEm  DateTime          @default(now())
  validacao  ValidacaoPresenca @default(PENDENTE)
  atrasoMin  Int               @default(0)
  status     StatusPresenca    @default(PENDENTE)
  ip         String?           @db.VarChar(50)
  dispositivo String?          @db.VarChar(100)

  sessao SessaoChamada @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  aluno  Usuario       @relation(fields: [alunoId], references: [id])

  // RN10: aluno só registra 1x por sessão
  @@unique([sessaoId, alunoId])
  @@index([alunoId])
}

// ============================================
// PERGUNTA / INTERAÇÃO
// ============================================

model Pergunta {
  id        Int          @id @default(autoincrement())
  sessaoId  Int
  tipo      TipoPergunta
  enunciado String       @db.VarChar(255)
  ativa     Boolean      @default(true)
  criadaEm  DateTime     @default(now())

  sessao    SessaoChamada   @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  opcoes    OpcaoPergunta[]
  respostas Resposta[]

  @@index([sessaoId, ativa])
}

model OpcaoPergunta {
  id         Int     @id @default(autoincrement())
  perguntaId Int
  descricao  String  @db.VarChar(255)
  correta    Boolean @default(false)

  pergunta  Pergunta   @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  respostas Resposta[]
}

model Resposta {
  id           Int      @id @default(autoincrement())
  perguntaId   Int
  alunoId      Int
  opcaoId      Int?
  textoLivre   String?  @db.VarChar(500) // para perguntas tipo TEXTO
  respondidoEm DateTime @default(now())
  correta      Boolean  @default(false)

  pergunta Pergunta       @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  aluno    Usuario        @relation(fields: [alunoId], references: [id])
  opcao    OpcaoPergunta? @relation(fields: [opcaoId], references: [id])

  // Aluno só responde uma pergunta uma vez
  @@unique([perguntaId, alunoId])
}

// ============================================
// PARÂMETROS DO SISTEMA
// ============================================

model Parametro {
  id        Int     @id @default(autoincrement())
  chave     String  @unique @db.VarChar(50)
  descricao String  @db.VarChar(100)
  valor     String  @db.VarChar(50)
  tipo      String  @db.VarChar(30) // MIN, P, INT, etc.
  ativo     Boolean @default(true)
}

// ============================================
// AUDITORIA
// ============================================

model AuditoriaLog {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  acao       String   @db.VarChar(100)
  entidade   String   @db.VarChar(50)
  dataEvento DateTime @default(now())
  detalhes   String?  @db.Text
  ip         String?  @db.VarChar(50)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([acao])
  @@index([dataEvento])
}
