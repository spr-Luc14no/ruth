// RUTh — Schema do banco de dados (PR7: remodelagem com Disciplina)
// Provider: MySQL (compatível com TiDB Cloud)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  A
  P
  U
}

enum StatusUsuario {
  A
  B
}

enum StatusSessao {
  ABERTA
  ENCERRADA
  PAUSADA
}

enum ValidacaoPresenca {
  OK
  FALHA
  PENDENTE
}

enum StatusPresenca {
  CONFIRMADO
  PENDENTE
  INVALIDO
}

enum TipoPergunta {
  MULTIPLA
  MULTIPLA_MULTI
  VF
  ENQUETE
  TEXTO
  IMAGEM
}

model Usuario {
  id        Int           @id @default(autoincrement())
  nome      String        @db.VarChar(100)
  email     String        @unique @db.VarChar(100)
  login     String        @unique @db.VarChar(50)
  senha     String        @db.VarChar(255)
  tipo      TipoUsuario
  status    StatusUsuario @default(A)
  matricula String?       @unique @db.VarChar(50)
  criadoEm  DateTime      @default(now())

  disciplinasMinistradas Disciplina[]    @relation("ProfessorDisciplina")
  matriculas             Matricula[]
  sessoesAbertas         SessaoChamada[] @relation("ProfessorSessao")
  presencas              Presenca[]
  respostas              Resposta[]
  perguntasBanco         PerguntaBanco[] @relation("AutorPerguntaBanco")
  logs                   AuditoriaLog[]

  @@index([tipo, status])
}

model Turma {
  id      Int    @id @default(autoincrement())
  nome    String @db.VarChar(100)
  periodo String @db.VarChar(50)

  disciplinas Disciplina[]
  matriculas  Matricula[]
}

model Disciplina {
  id          Int    @id @default(autoincrement())
  nome        String @db.VarChar(100)
  turmaId     Int
  professorId Int

  toleranciaAtrasoMin Int?
  janelaPadraoMin     Int?

  turma          Turma           @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  professor      Usuario         @relation("ProfessorDisciplina", fields: [professorId], references: [id])
  sessoes        SessaoChamada[]
  perguntasBanco PerguntaBanco[]

  @@index([turmaId])
  @@index([professorId])
}

model Matricula {
  alunoId Int
  turmaId Int

  aluno Usuario @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([alunoId, turmaId])
}

model SessaoChamada {
  id               Int          @id @default(autoincrement())
  disciplinaId     Int
  professorId      Int
  dataAbertura     DateTime     @default(now())
  dataEncerramento DateTime?
  janelaMin        Int          @default(10)
  status           StatusSessao @default(ABERTA)
  codigo           String       @unique @db.VarChar(10)

  disciplina Disciplina @relation(fields: [disciplinaId], references: [id])
  professor  Usuario    @relation("ProfessorSessao", fields: [professorId], references: [id])
  presencas  Presenca[]
  perguntas  Pergunta[]

  @@index([disciplinaId, status])
  @@index([codigo])
}

model Presenca {
  id          Int               @id @default(autoincrement())
  sessaoId    Int
  alunoId     Int
  marcadoEm   DateTime          @default(now())
  validacao   ValidacaoPresenca @default(PENDENTE)
  atrasoMin   Int               @default(0)
  status      StatusPresenca    @default(PENDENTE)
  ip          String?           @db.VarChar(50)
  dispositivo String?           @db.VarChar(100)

  sessao SessaoChamada @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  aluno  Usuario       @relation(fields: [alunoId], references: [id])

  @@unique([sessaoId, alunoId])
  @@index([alunoId])
}

model Pergunta {
  id          Int          @id @default(autoincrement())
  sessaoId    Int
  tipo        TipoPergunta
  enunciado   String       @db.VarChar(500)
  imagemUrl   String?      @db.VarChar(500)
  tempoLimite Int?
  ativa       Boolean      @default(true)
  criadaEm    DateTime     @default(now())
  encerradaEm DateTime?

  sessao    SessaoChamada   @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  opcoes    OpcaoPergunta[]
  respostas Resposta[]

  @@index([sessaoId, ativa])
}

model OpcaoPergunta {
  id         Int     @id @default(autoincrement())
  perguntaId Int
  descricao  String  @db.VarChar(255)
  correta    Boolean @default(false)

  pergunta  Pergunta   @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  respostas Resposta[]
}

model Resposta {
  id           Int      @id @default(autoincrement())
  perguntaId   Int
  alunoId      Int
  opcaoId      Int?
  textoLivre   String?  @db.VarChar(500)
  respondidoEm DateTime @default(now())
  tempoRespSeg Int?
  correta      Boolean  @default(false)

  pergunta Pergunta       @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  aluno    Usuario        @relation(fields: [alunoId], references: [id])
  opcao    OpcaoPergunta? @relation(fields: [opcaoId], references: [id])

  @@unique([perguntaId, alunoId])
}

model PerguntaBanco {
  id           Int          @id @default(autoincrement())
  professorId  Int
  disciplinaId Int?
  tipo         TipoPergunta
  enunciado    String       @db.VarChar(500)
  imagemUrl    String?      @db.VarChar(500)
  tempoLimite  Int?
  criadaEm     DateTime     @default(now())

  professor  Usuario      @relation("AutorPerguntaBanco", fields: [professorId], references: [id], onDelete: Cascade)
  disciplina Disciplina?  @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  opcoes     OpcaoBanco[]

  @@index([professorId])
  @@index([disciplinaId])
}

model OpcaoBanco {
  id         Int     @id @default(autoincrement())
  perguntaId Int
  descricao  String  @db.VarChar(255)
  correta    Boolean @default(false)

  pergunta PerguntaBanco @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
}

model Parametro {
  id        Int     @id @default(autoincrement())
  chave     String  @unique @db.VarChar(50)
  descricao String  @db.VarChar(100)
  valor     String  @db.VarChar(50)
  tipo      String  @db.VarChar(30)
  ativo     Boolean @default(true)
}

model AuditoriaLog {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  acao       String   @db.VarChar(100)
  entidade   String   @db.VarChar(50)
  dataEvento DateTime @default(now())
  detalhes   String?  @db.Text
  ip         String?  @db.VarChar(50)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([acao])
  @@index([dataEvento])
}
